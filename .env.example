# App (for Docker use .env.docker.example → cp .env.docker.example .env)
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker full stack: see docs/DOCKER_DEPLOY.md

# Token encryption (REQUIRED for multi-tenant OAuth)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/socialflow?retryWrites=true&w=majority

# n8n — orchestration only (no user OAuth stored in n8n)
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/socialflow-generate
N8N_API_KEY=
N8N_TIMEOUT_MS=120000
N8N_MAX_RETRIES=2

# Firecrawl
FIRECRAWL_API_KEY=fc-...

# Media uploads (optional composer images)
MEDIA_UPLOAD_DIR=data/uploads
MEDIA_INTERNAL_BASE_URL=http://localhost:3000

# --- Platform OAuth (backend only, never expose to frontend) ---

# LinkedIn — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta — Facebook Pages + Instagram Business (shared Facebook Login app)
META_APP_ID=
META_APP_SECRET=

# Threads — separate Threads app (https://developers.facebook.com/docs/threads)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Dev.to — users paste API key via dashboard (DEVTO_API_KEY optional for validation)
DEVTO_API_KEY=

# YouTube Community tab only (text/image posts — NOT video/Shorts uploads)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Product Hunt — https://api.producthunt.com/v2/docs
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Rate limiting & credits
RATE_LIMIT_POINTS=20
RATE_LIMIT_DURATION_SEC=3600
DEFAULT_USER_CREDITS=50

# Optional Redis
REDIS_URL=redis://localhost:6379
USE_QUEUE=false
