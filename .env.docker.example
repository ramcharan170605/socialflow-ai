# =============================================================================
# SocialFlow AI — Docker Compose environment
# Copy to .env:  cp .env.docker.example .env
# =============================================================================

# --- Public URL (used by Clerk, OAuth redirects, client bundle) ---
# Local:    http://localhost
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost
HTTP_PORT=80

# --- MongoDB Atlas (external) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/socialflow?retryWrites=true&w=majority

# --- Token encryption (REQUIRED) ---
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- n8n (internal Docker network) ---
# Backend calls n8n via service name — do NOT expose this URL to browsers
N8N_WEBHOOK_URL=http://n8n:5678/webhook/socialflow-generate
N8N_WAIT_URL=http://n8n:5678/healthz
N8N_API_KEY=
N8N_TIMEOUT_MS=120000
N8N_MAX_RETRIES=2

# n8n instance secrets (generate random strings)
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

# Only needed if exposing n8n admin UI (--profile n8n-admin)
N8N_PUBLIC_WEBHOOK_BASE=http://n8n:5678
N8N_EDITOR_BASE_URL=http://localhost/n8n

# --- Firecrawl ---
FIRECRAWL_API_KEY=fc-...

# --- Media uploads (composer images) ---
MEDIA_UPLOAD_DIR=data/uploads
MEDIA_INTERNAL_BASE_URL=http://app:3000

# --- OpenAI (used inside n8n LLM nodes — configure in n8n UI, not here) ---
# OPENAI_API_KEY is set as n8n credential after import

# --- Platform OAuth (backend) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
DEVTO_API_KEY=
# YouTube Community tab only (text/image — no video upload scopes)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# --- App limits ---
RATE_LIMIT_POINTS=20
RATE_LIMIT_DURATION_SEC=3600
DEFAULT_USER_CREDITS=50
USE_QUEUE=false

# Optional Redis (docker compose --profile queue)
REDIS_URL=redis://redis:6379

TZ=UTC
